  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "     Planet Earth is running out of energy. A clone of Captain Dirk Dingus
    has been sent to mine <i>Gammanite</i> - rare radioactive crystals found only
    in the far reaches of the galaxy.  Who knows what else awaits him in the great
    beyond?\n\n     Captain Dirk is more handsome than Captain Kirk ever was, so
    space nookie is not out of the question. However, he's neither smart or courageous,
    and will probably fail.  And by \"fail\", I mean \"die\".\n\n     But that's
    ok.  If he does, we'll just send up another clone..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 048f68ccba7924eb1a7870d9a1e89245, type: 2}
